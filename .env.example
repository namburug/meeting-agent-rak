# Copy this file to .env and fill in real values before processing a meeting.

# Which LLM does the extraction step. One of: anthropic | openai | google
# Only the API key for the provider you pick needs to be filled in below.
LLM_PROVIDER=anthropic

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (used if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Google (used if LLM_PROVIDER=google) ---
GOOGLE_API_KEY=your-key-here
GOOGLE_MODEL=gemini-2.0-flash

# Optional: enables the Slack recap side effect.
# Create a test/sandbox Slack workspace and an Incoming Webhook there — do NOT point this at a production workspace.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLEASE

# Where the SQLite database file is written
DATABASE_PATH=./data/app.db
